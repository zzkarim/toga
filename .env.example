# Local development template. Copy to .env and fill in. Never commit real values.
# Local Postgres from `npm run db:local` (dev-only credentials).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/toga?schema=toga"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/toga?schema=toga"
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"

# Email: leave DEV_EMAIL_PREVIEW=true locally to see links in-app instead of sending.
EMAIL_PROVIDER="resend"
EMAIL_FROM="Toga <login@jointoga.com>"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
DEV_EMAIL_PREVIEW="true"
REQUIRE_EMAIL_VERIFICATION="true"
ENFORCE_VERIFIED_ACCOUNTS="false"

# Storage: "local" for development; "supabase" in production.
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

CRON_SECRET="change-me-local-only"
TOGA_THEME="halloween"

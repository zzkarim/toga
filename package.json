{
  "name": "toga",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "db:studio": "prisma studio",
    "test": "node --test tests/*.test.mjs",
    "jobs": "node --env-file=.env scripts/jobs.mjs",
    "test:integration": "node --env-file=.env tests/integration.mjs",
    "db:deploy": "prisma migrate deploy",
    "check:production": "node scripts/check-production.mjs",
    "format": "prettier --write app components lib scripts tests prisma/seed.mjs",
    "build:vercel": "node scripts/check-production.mjs && prisma generate && next build",
    "db:local": "node scripts/local-postgres.mjs",
    "storage:setup": "node --env-file=.env.production.local scripts/setup-storage.mjs",
    "db:import-sqlite": "node --env-file=.env.production.local scripts/import-sqlite.mjs",
    "verify:hosted": "node --env-file=.env.production.local scripts/verify-hosted.mjs",
    "lint": "eslint app components lib scripts next.config.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "nodemailer": "^10.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas = ["toga"]
}
model User {
  accountStatus String @default("Active")
  termsAcceptedAt DateTime?
  termsVersion String?
  privacyVersion String?
  ageConfirmedAt DateTime?
  rentalActivity RentalActivity[]
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  emailVerifiedAt DateTime?
  name String @default("")
  phone String @default("")
  classYear Int?
  profilePhotoUrl String?
  paymentInfo String?
  supplyPromptHandledAt DateTime?
  wantedSeenAt DateTime?
  role String @default("user")
  createdAt DateTime @default(now())
  listings Listing[]
  sessions Session[]
  wantedPosts WantedPost[]
  @@schema("toga")
}
model Session {
  passwordSetupUntil DateTime?
  canSetPassword Boolean @default(false)
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@schema("toga")
}
model LoginToken {
  id String @id
  email String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@schema("toga")
}
model Listing {
  lenderConfirmedAt DateTime?
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  title String
  description String
  categories String[] @default([])
  customCategory String?
  moderationStatus String @default("Visible")
  category String @default("")
  size String
  condition String
  retailValue Float?
  price Float
  photos String
  status String @default("Active")
  highValue Boolean @default(false)
  isDemo Boolean @default(false)
  blockedRanges Json @default("[]")
  createdAt DateTime @default(now())
  requests RentalRequest[]
  sourceWantedId String?
  sourceWanted WantedPost? @relation(fields: [sourceWantedId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([sourceWantedId])
  @@schema("toga")
}
model RentalRequest {
  renterAcknowledgedReplacementValue Float?
  renterAcknowledgedAt DateTime?
  renterAcknowledgedTermsVersion String?
  activity RentalActivity[]
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id])
  renterId String
  lenderId String
  startDate DateTime
  endDate DateTime
  pricePerDay Float @default(0)
  status String @default("Pending")
  pickupReminderSent Boolean @default(false)
  returnReminderSent Boolean @default(false)
  createdAt DateTime @default(now())
  ratings Rating[]
  reports ProblemReport[]
  checks ConditionCheck[]
  @@schema("toga")
}
model Rating {
  id String @id @default(cuid())
  requestId String
  request RentalRequest @relation(fields: [requestId], references: [id])
  raterId String
  ratedUserId String
  score Int
  comment String?
  createdAt DateTime @default(now())
  @@unique([requestId, raterId])
  @@schema("toga")
}
model ProblemReport {
  status String @default("Open")
  adminNote String @default("")
  resolvedAt DateTime?
  id String @id @default(cuid())
  requestId String
  request RentalRequest @relation(fields: [requestId], references: [id])
  reporterId String
  description String
  photoUrl String?
  createdAt DateTime @default(now())
  @@schema("toga")
}
model ConditionCheck {
  id String @id @default(cuid())
  requestId String
  request RentalRequest @relation(fields: [requestId], references: [id])
  userId String
  stage String
  photoUrl String
  createdAt DateTime @default(now())
  @@schema("toga")
}
model Email {
  provider String @default("gmail")
  providerEventAt DateTime?
  deliveredAt DateTime?
  id String @id @default(cuid())
  to String
  subject String
  text String
  sentAt DateTime?
  deliveryStatus String @default("Queued")
  attempts Int @default(0)
  claimedAt DateTime?
  providerMessageId String?
  error String?
  createdAt DateTime @default(now())
  @@schema("toga")
}

model Upload {
  id String @id
  ownerId String
  createdAt DateTime @default(now())
  @@index([ownerId, createdAt])
  @@schema("toga")
}
model RateLimit {
  id String @id
  count Int @default(1)
  resetsAt DateTime
  @@schema("toga")
}

model EmailOtp {
  email String @id
  challenge String @unique
  digest String
  expiresAt DateTime
  resendAt DateTime
  attempts Int @default(0)
  @@index([expiresAt])
  @@schema("toga")
}

model RentalActivity {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  request RentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  message String
  createdAt DateTime @default(now())
  readAt DateTime?
  @@index([userId, readAt, createdAt])
  @@schema("toga")
}

model AdminAudit {
  id String @id @default(cuid())
  adminId String
  action String
  targetType String
  targetId String
  note String
  createdAt DateTime @default(now())
  @@index([targetType, targetId, createdAt])
  @@schema("toga")
}

model EmailDeliveryEvent {
  id String @id
  providerMessageId String
  type String
  occurredAt DateTime
  createdAt DateTime @default(now())
  @@index([providerMessageId])
  @@schema("toga")
}

// "I want someone to list this": a demand signal above listings, never a rental.
model WantedPost {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  title String
  details String @default("")
  size String?
  startDate DateTime
  endDate DateTime
  status String @default("Open")
  moderationStatus String @default("Visible")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listings Listing[]
  @@index([status, moderationStatus, endDate, createdAt])
  @@index([userId, createdAt])
  @@schema("toga")
}
